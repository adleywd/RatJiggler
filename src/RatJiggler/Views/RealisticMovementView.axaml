<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:RatJiggler.ViewModels"
             xmlns:converters="clr-namespace:RatJiggler.Converters"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="RatJiggler.Views.RealisticMovementView"
             x:DataType="vm:RealisticMovementViewModel">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="600" Margin="24,20" Spacing="0">

            <!-- Page Header -->
            <StackPanel Margin="0,0,0,20">
                <TextBlock Text="Realistic Movement" Classes="pageTitle" />
                <TextBlock Text="Natural random mouse movement with configurable speed and pauses" Classes="pageSubtitle" />
            </StackPanel>

            <!-- Speed Section -->
            <Border Classes="surface">
                <StackPanel Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <mi:MaterialIcon Kind="SpeedometerMedium" Width="20" Height="20"
                                         Foreground="{DynamicResource PrimaryLightColor}" />
                        <TextBlock Text="Speed" Classes="sectionTitle" VerticalAlignment="Center" />
                    </StackPanel>

                    <Grid ColumnDefinitions="*,24,*" RowDefinitions="Auto,Auto">
                        <TextBlock Text="Min speed" Classes="fieldLabel"
                                   Grid.Row="0" Grid.Column="0" />
                        <TextBlock Text="Max speed" Classes="fieldLabel"
                                   Grid.Row="0" Grid.Column="2" />

                        <NumericUpDown Value="{Binding MinSpeed}" Maximum="10" Minimum="1"
                                       Grid.Row="1" Grid.Column="0"
                                       ToolTip.Tip="Slowest possible movement speed" />
                        <NumericUpDown Value="{Binding MaxSpeed}" Maximum="10" Minimum="1"
                                       Grid.Row="1" Grid.Column="2"
                                       ToolTip.Tip="Fastest possible movement speed" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Step Pauses Section -->
            <Border Classes="surface">
                <StackPanel Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <mi:MaterialIcon Kind="PauseCircleOutline" Width="20" Height="20"
                                         Foreground="{DynamicResource PrimaryLightColor}" />
                        <TextBlock Text="Step Pauses" Classes="sectionTitle" VerticalAlignment="Center" />
                    </StackPanel>

                    <ToggleSwitch IsChecked="{Binding EnableStepPauses}"
                                  Content="Pause between movements"
                                  ToolTip.Tip="Add short pauses after each mouse movement" />

                    <Grid ColumnDefinitions="*,24,*" RowDefinitions="Auto,Auto"
                          IsEnabled="{Binding EnableStepPauses}">
                        <TextBlock Text="Min (ms)" Classes="fieldLabel"
                                   Grid.Row="0" Grid.Column="0" />
                        <TextBlock Text="Max (ms)" Classes="fieldLabel"
                                   Grid.Row="0" Grid.Column="2" />

                        <NumericUpDown Value="{Binding StepPauseMin}" Minimum="0"
                                       Grid.Row="1" Grid.Column="0"
                                       ToolTip.Tip="Minimum time between movements (in milliseconds)" />
                        <NumericUpDown Value="{Binding StepPauseMax}" Minimum="0"
                                       Grid.Row="1" Grid.Column="2"
                                       ToolTip.Tip="Maximum time between movements (in milliseconds)" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Random Pauses Section -->
            <Border Classes="surface">
                <StackPanel Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <mi:MaterialIcon Kind="ShuffleVariant" Width="20" Height="20"
                                         Foreground="{DynamicResource PrimaryLightColor}" />
                        <TextBlock Text="Random Pauses" Classes="sectionTitle" VerticalAlignment="Center" />
                    </StackPanel>

                    <ToggleSwitch IsChecked="{Binding EnableRandomPauses}"
                                  Content="Add random pauses"
                                  ToolTip.Tip="Occasionally insert longer pauses to mimic human behavior" />

                    <Grid ColumnDefinitions="*,24,*" RowDefinitions="Auto,Auto,Auto,Auto"
                          IsEnabled="{Binding EnableRandomPauses}">
                        <TextBlock Text="Min (ms)" Classes="fieldLabel"
                                   Grid.Row="0" Grid.Column="0" />
                        <TextBlock Text="Max (ms)" Classes="fieldLabel"
                                   Grid.Row="0" Grid.Column="2" />

                        <NumericUpDown Value="{Binding RandomPauseMin}" Minimum="0"
                                       Grid.Row="1" Grid.Column="0"
                                       ToolTip.Tip="Minimum duration for random pauses" />
                        <NumericUpDown Value="{Binding RandomPauseMax}" Minimum="0"
                                       Grid.Row="1" Grid.Column="2"
                                       ToolTip.Tip="Maximum duration for random pauses" />

                        <TextBlock Text="Chance (%)" Classes="fieldLabel"
                                   Grid.Row="2" Grid.Column="0" Margin="0,12,0,4" />

                        <NumericUpDown Value="{Binding RandomPauseProbability}" Maximum="100" Minimum="0"
                                       Grid.Row="3" Grid.Column="0"
                                       ToolTip.Tip="How likely a random pause will occur (0-100%)" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Advanced Section -->
            <Border Classes="surface">
                <StackPanel Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <mi:MaterialIcon Kind="TuneVerticalVariant" Width="20" Height="20"
                                         Foreground="{DynamicResource PrimaryLightColor}" />
                        <TextBlock Text="Advanced" Classes="sectionTitle" VerticalAlignment="Center" />
                    </StackPanel>

                    <ToggleSwitch IsChecked="{Binding EnableUserInterventionDetection}"
                                  Content="Stop on manual mouse movement"
                                  ToolTip.Tip="Automatically stops when you move the mouse yourself" />

                    <Grid ColumnDefinitions="*,24,*" RowDefinitions="Auto,Auto"
                          IsEnabled="{Binding EnableUserInterventionDetection}">
                        <TextBlock Text="Sensitivity (px)" Classes="fieldLabel"
                                   Grid.Row="0" Grid.Column="0" />

                        <NumericUpDown Value="{Binding MovementThresholdInPixels}" Minimum="0"
                                       Grid.Row="1" Grid.Column="0"
                                       ToolTip.Tip="How far you need to move the mouse to stop automation" />
                    </Grid>

                    <Separator />

                    <Grid ColumnDefinitions="*,24,*" RowDefinitions="Auto,Auto">
                        <TextBlock Text="Random seed" Classes="fieldLabel"
                                   Grid.Row="0" Grid.Column="0" />

                        <NumericUpDown Value="{Binding RandomSeed}" Minimum="0"
                                       Grid.Row="1" Grid.Column="0"
                                       ToolTip.Tip="Set a fixed number for predictable random patterns" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Mouse Click Section -->
            <Border Classes="surface">
                <StackPanel Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <mi:MaterialIcon Kind="Mouse" Width="20" Height="20"
                                         Foreground="{DynamicResource PrimaryLightColor}" />
                        <TextBlock Text="Mouse Click" Classes="sectionTitle" VerticalAlignment="Center" />
                    </StackPanel>

                    <ToggleSwitch IsChecked="{Binding EnableClick}"
                                  Content="Enable mouse clicking"
                                  ToolTip.Tip="When enabled, a mouse click will be performed at the configured interval" />

                    <StackPanel Orientation="Horizontal" Spacing="16" IsEnabled="{Binding EnableClick}">
                        <RadioButton Content="Left click"
                                     IsChecked="{Binding ClickButton, Converter={x:Static converters:IntEqualConverter.Instance}, ConverterParameter=1}"
                                     GroupName="RealisticClickButton"
                                     ToolTip.Tip="Perform left mouse clicks" />
                        <RadioButton Content="Right click"
                                     IsChecked="{Binding ClickButton, Converter={x:Static converters:IntEqualConverter.Instance}, ConverterParameter=2}"
                                     GroupName="RealisticClickButton"
                                     ToolTip.Tip="Perform right mouse clicks" />
                    </StackPanel>

                    <Grid ColumnDefinitions="*,24,*" IsEnabled="{Binding EnableClick}">
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Interval (sec)" Classes="fieldLabel" />
                            <NumericUpDown Value="{Binding ClickIntervalSeconds}" Minimum="1"
                                           ToolTip.Tip="Click interval in seconds" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Buttons -->
            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,4,0,0" HorizontalAlignment="Right">
                <Button Command="{Binding SaveSettingsCommand}"
                        ToolTip.Tip="Save your current settings for next time">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <mi:MaterialIcon Kind="ContentSaveOutline" Width="18" Height="18" />
                        <TextBlock Text="Save Settings" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding RestoreDefaultsCommand}"
                        Classes="secondary"
                        ToolTip.Tip="Restore all settings to their original values">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <mi:MaterialIcon Kind="Restart" Width="18" Height="18" />
                        <TextBlock Text="Reset to Defaults" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
