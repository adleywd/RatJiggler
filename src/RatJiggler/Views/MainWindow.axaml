<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RatJiggler.Views"
        xmlns:vm="using:RatJiggler.ViewModels"
        xmlns:converters="clr-namespace:RatJiggler.Converters"
        xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="680"
        x:Class="RatJiggler.Views.MainWindow"
        x:Name="MainWin"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/logo.ico"
        Title="{Binding Title}"
        MinHeight="560"
        MinWidth="780"
        Height="850"
        Width="850"
        CanResize="True"
        ShowInTaskbar="{Binding ShowInTaskbar}"
        WindowState="{Binding WindowState, Mode=TwoWay}"
        WindowStartupLocation="CenterScreen"
        SystemDecorations="Full"
        UseLayoutRounding="True"
        RequestedThemeVariant="Dark">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <!-- Key Bindings -->
    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+R"
                    Command="{Binding StartMouseMovementByHotkeyCommand}" />
        <KeyBinding Gesture="Ctrl+C"
                    Command="{Binding StopMovementCommand}" />
    </Window.KeyBindings>

    <!-- Root: Sidebar + Content -->
    <Grid ColumnDefinitions="Auto,*">

        <!-- ═══════════════════════════════════════ -->
        <!--  SIDEBAR                                -->
        <!-- ═══════════════════════════════════════ -->
        <Border Grid.Column="0" Classes="sidebar">
            <DockPanel>
                <!-- Top: Logo + App Name -->
                <StackPanel DockPanel.Dock="Top" Margin="16,20,16,24" Spacing="8">
                    <Image Source="/Assets/logo-no-background.png"
                           Width="48" Height="48"
                           HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding Title}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="White"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <!-- Bottom: Start/Stop Button -->
                <Panel DockPanel.Dock="Bottom" Margin="12,0,12,16">
                    <Button Classes="toggleStart"
                            Command="{Binding ToggleMovementCommand}"
                            IsVisible="{Binding !IsMovementRunning}">
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                            <mi:MaterialIcon Kind="Play" Width="20" Height="20" />
                            <TextBlock Text="Start" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="toggleStop"
                            Command="{Binding ToggleMovementCommand}"
                            IsVisible="{Binding IsMovementRunning}">
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                            <mi:MaterialIcon Kind="Stop" Width="20" Height="20" />
                            <TextBlock Text="Stop" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Panel>

                <!-- Middle: Navigation Items -->
                <StackPanel Spacing="2" Margin="0,8,0,0">
                    <!-- Simple -->
                    <RadioButton Classes="sidebarItem"
                                 IsChecked="{Binding SelectedTabIndex, Converter={x:Static converters:IntEqualConverter.Instance}, ConverterParameter=0}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <mi:MaterialIcon Kind="CursorMove" Width="20" Height="20" />
                            <TextBlock Text="Simple" VerticalAlignment="Center" FontSize="14" />
                        </StackPanel>
                    </RadioButton>

                    <!-- Realistic -->
                    <RadioButton Classes="sidebarItem"
                                 IsChecked="{Binding SelectedTabIndex, Converter={x:Static converters:IntEqualConverter.Instance}, ConverterParameter=1}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <mi:MaterialIcon Kind="GestureTapButton" Width="20" Height="20" />
                            <TextBlock Text="Realistic" VerticalAlignment="Center" FontSize="14" />
                        </StackPanel>
                    </RadioButton>

                    <!-- Settings -->
                    <RadioButton Classes="sidebarItem"
                                 IsChecked="{Binding SelectedTabIndex, Converter={x:Static converters:IntEqualConverter.Instance}, ConverterParameter=2}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <mi:MaterialIcon Kind="CogOutline" Width="20" Height="20" />
                            <TextBlock Text="Settings" VerticalAlignment="Center" FontSize="14" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ═══════════════════════════════════════ -->
        <!--  CONTENT AREA                           -->
        <!-- ═══════════════════════════════════════ -->
        <DockPanel Grid.Column="1">

            <!-- Header Bar -->
            <Border DockPanel.Dock="Top" Classes="headerBar">
                <Grid ColumnDefinitions="*,Auto">
                    <!-- Status Message -->
                    <Border Grid.Column="0"
                            Classes="statusBar"
                            Background="{Binding StatusMessageBackground}"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Left"
                            IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <mi:MaterialIcon Kind="InformationOutline" Width="16" Height="16"
                                             Foreground="{Binding StatusMessageColor}" />
                            <TextBlock Text="{Binding StatusMessage}"
                                       VerticalAlignment="Center"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{Binding StatusMessageColor}" />
                        </StackPanel>
                    </Border>

                    <!-- Hotkey Badge -->
                    <Border Grid.Column="1"
                            Classes="hotkeyBadge"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <mi:MaterialIcon Kind="KeyboardOutline" Width="16" Height="16"
                                             Foreground="{DynamicResource TextTertiaryColor}" />
                            <TextBlock Text="{Binding GlobalHotkeyDisplayString}"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       FontSize="12" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Page Content (switched by SelectedTabIndex) -->
            <Panel>
                <!-- Page 0: Simple Movement -->
                <local:SimpleMovementView
                    DataContext="{Binding SimpleMovementViewModel}"
                    IsVisible="{Binding #MainWin.((vm:MainWindowViewModel)DataContext).SelectedTabIndex, Converter={x:Static converters:IntEqualConverter.Instance}, ConverterParameter=0}" />

                <!-- Page 1: Realistic Movement -->
                <local:RealisticMovementView
                    DataContext="{Binding RealisticMovementViewModel}"
                    IsVisible="{Binding #MainWin.((vm:MainWindowViewModel)DataContext).SelectedTabIndex, Converter={x:Static converters:IntEqualConverter.Instance}, ConverterParameter=1}" />

                <!-- Page 2: Settings -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              IsVisible="{Binding SelectedTabIndex, Converter={x:Static converters:IntEqualConverter.Instance}, ConverterParameter=2}">
                    <StackPanel MaxWidth="600" Margin="24,20" Spacing="0">
                        <!-- Page Header -->
                        <StackPanel Margin="0,0,0,20">
                            <TextBlock Text="Settings" Classes="pageTitle" />
                            <TextBlock Text="Configure application behavior and preferences" Classes="pageSubtitle" />
                        </StackPanel>

                        <!-- Startup Section -->
                        <Border Classes="surface">
                            <StackPanel Spacing="16">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <mi:MaterialIcon Kind="RocketLaunchOutline" Width="20" Height="20"
                                                     Foreground="{DynamicResource PrimaryLightColor}" />
                                    <TextBlock Text="Startup" Classes="sectionTitle" VerticalAlignment="Center" />
                                </StackPanel>

                                <ToggleSwitch IsChecked="{Binding AutoStartMovement}"
                                              Content="Auto-start movement on launch"
                                              ToolTip.Tip="When enabled, mouse movement will start automatically when the application starts" />
                            </StackPanel>
                        </Border>

                        <!-- Tray Section -->
                        <Border Classes="surface">
                            <StackPanel Spacing="16">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <mi:MaterialIcon Kind="TrayArrowDown" Width="20" Height="20"
                                                     Foreground="{DynamicResource PrimaryLightColor}" />
                                    <TextBlock Text="System Tray" Classes="sectionTitle" VerticalAlignment="Center" />
                                </StackPanel>

                                <ToggleSwitch IsChecked="{Binding MinimizeToTray}"
                                              Content="Minimize to tray"
                                              ToolTip.Tip="When enabled, the application will minimize to the system tray" />

                                <ToggleSwitch IsChecked="{Binding StartMinimizedToTray}"
                                              IsEnabled="{Binding MinimizeToTray}"
                                              Content="Start minimized to tray"
                                              Margin="24,0,0,0"
                                              ToolTip.Tip="When enabled, the application will start minimized to the system tray" />
                            </StackPanel>
                        </Border>

                        <!-- Hotkey Section -->
                        <Border Classes="surface">
                            <StackPanel Spacing="16">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <mi:MaterialIcon Kind="KeyboardOutline" Width="20" Height="20"
                                                     Foreground="{DynamicResource PrimaryLightColor}" />
                                    <TextBlock Text="Global Hotkey" Classes="sectionTitle" VerticalAlignment="Center" />
                                </StackPanel>

                                <StackPanel Spacing="12">
                                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                        <Border Background="{DynamicResource BackgroundMediumColor}"
                                                BorderBrush="{DynamicResource BorderLightColor}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="12,8"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding GlobalHotkeyDisplayString}"
                                                       IsVisible="{Binding !IsCapturingHotkey}"
                                                       VerticalAlignment="Center"
                                                       FontWeight="SemiBold"
                                                       FontSize="14" />
                                        </Border>
                                        <TextBlock Text="Press keys..."
                                                   IsVisible="{Binding IsCapturingHotkey}"
                                                   VerticalAlignment="Center"
                                                   FontStyle="Italic"
                                                   Opacity="0.7" />
                                        <Button Content="Change"
                                                Command="{Binding StartCapturingHotkeyCommand}"
                                                IsVisible="{Binding !IsCapturingHotkey}"
                                                Padding="12,8"
                                                ToolTip.Tip="Click to set a new global hotkey" />
                                        <Button Content="Cancel"
                                                Command="{Binding CancelCapturingHotkeyCommand}"
                                                IsVisible="{Binding IsCapturingHotkey}"
                                                Classes="secondary"
                                                Padding="12,8" />
                                        <Button Content="Reset"
                                                Command="{Binding ResetHotkeyCommand}"
                                                Classes="secondary"
                                                Padding="12,8"
                                                ToolTip.Tip="Reset hotkey to Ctrl+Shift+F9" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Panel>
        </DockPanel>
    </Grid>
</Window>
