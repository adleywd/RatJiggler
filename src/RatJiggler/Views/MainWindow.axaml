<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RatJiggler.Views"
        xmlns:vm="using:RatJiggler.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="RatJiggler.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/logo.ico"
        Title="{Binding Title}"
        MinHeight="580"
        MinWidth="640"
        Height="800"
        Width="700"
        CanResize="True"
        ShowInTaskbar="{Binding ShowInTaskbar}"
        WindowState="{Binding WindowState, Mode=TwoWay}"
        WindowStartupLocation="CenterScreen"
        SystemDecorations="Full"
        UseLayoutRounding="True"
        RequestedThemeVariant="Dark">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <!-- Key Bindings for Keyboard Shortcuts -->
    <Window.KeyBindings>
        <!-- Ctrl + R to Start Movement -->
        <KeyBinding Gesture="Ctrl+R"
                    Command="{Binding StartMouseMovementByHotkeyCommand}" />

        <!-- Ctrl + C to Stop Movement -->
        <KeyBinding Gesture="Ctrl+C"
                    Command="{Binding StopMovementCommand}" />
    </Window.KeyBindings>

    <Border Background="{DynamicResource BackgroundMediumColor}" CornerRadius="8" Margin="5">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />  <!-- Action Bar -->
                <RowDefinition Height="*" />     <!-- Settings Tabs -->
                <RowDefinition Height="Auto" />  <!-- App Settings Expander -->
            </Grid.RowDefinitions>

            <!-- Row 0: Action Bar -->
            <Border Grid.Row="0"
                    Background="{DynamicResource BackgroundDarkColor}"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource BorderLightColor}"
                    CornerRadius="5"
                    Padding="12"
                    Margin="0,0,0,15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />   <!-- Toggle Button -->
                        <ColumnDefinition Width="*" />      <!-- Status Message -->
                        <ColumnDefinition Width="Auto" />   <!-- Hotkey Badge -->
                    </Grid.ColumnDefinitions>

                    <!-- Toggle Button -->
                    <Panel Grid.Column="0" VerticalAlignment="Center">
                        <Button Classes="toggleStart"
                                Command="{Binding ToggleMovementCommand}"
                                Content="Start"
                                IsVisible="{Binding !IsMovementRunning}" />
                        <Button Classes="toggleStop"
                                Command="{Binding ToggleMovementCommand}"
                                Content="Stop"
                                IsVisible="{Binding IsMovementRunning}" />
                    </Panel>

                    <!-- Status Message -->
                    <Border Grid.Column="1"
                            Classes="statusBar"
                            Background="{Binding StatusMessageBackground}"
                            Margin="15,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding StatusMessage}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{Binding StatusMessageColor}" />
                    </Border>

                    <!-- Hotkey Badge -->
                    <Border Grid.Column="2"
                            Classes="hotkeyBadge"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Hotkey:"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextTertiaryColor}"
                                       FontSize="12" />
                            <TextBlock Text="{Binding GlobalHotkeyDisplayString}"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       FontSize="12" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Row 1: Settings Tabs -->
            <Border Grid.Row="1"
                    Background="{DynamicResource BackgroundDarkColor}"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource BorderLightColor}"
                    CornerRadius="5"
                    Padding="10"
                    Margin="0,0,0,15">

                <!-- Tab Control for Modes -->
                <TabControl SelectedIndex="{Binding SelectedTabIndex}"
                            HorizontalAlignment="Stretch"
                            TabStripPlacement="Top">
                    <TabControl.Styles>
                        <!-- Style for TabItem -->
                        <Style Selector="TabItem">
                            <Setter Property="Width" Value="280"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate>
                                        <Border Background="{TemplateBinding Background}"
                                                BorderThickness="0"
                                                BorderBrush="{TemplateBinding BorderBrush}">
                                            <ContentPresenter Content="{TemplateBinding Header}"
                                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                        <!-- Style for TextBlock in TabItem Header -->
                        <Style Selector="TabItem TextBlock">
                            <Setter Property="TextDecorations">
                                <Setter.Value>
                                    <TextDecorationCollection/>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TabControl.Styles>

                    <!-- Tabs -->
                    <TabItem Cursor="Hand">
                        <TabItem.Header>
                            <StackPanel>
                                <TextBlock Text="Simple" HorizontalAlignment="Center" />
                                <TextBlock Text="Fixed direction movement" FontSize="10" Opacity="0.6" HorizontalAlignment="Center" />
                            </StackPanel>
                        </TabItem.Header>
                        <local:SimpleMovementView DataContext="{Binding SimpleMovementViewModel}" />
                    </TabItem>
                    <TabItem Cursor="Hand">
                        <TabItem.Header>
                            <StackPanel>
                                <TextBlock Text="Realistic" HorizontalAlignment="Center" />
                                <TextBlock Text="Natural random movement" FontSize="10" Opacity="0.6" HorizontalAlignment="Center" />
                            </StackPanel>
                        </TabItem.Header>
                        <local:RealisticMovementView DataContext="{Binding RealisticMovementViewModel}" />
                    </TabItem>
                </TabControl>
            </Border>

            <!-- Row 2: App Settings Expander -->
            <Expander Grid.Row="2"
                      Header="App Settings"
                      IsExpanded="False"
                      HorizontalAlignment="Stretch">
                <Border Background="{DynamicResource BackgroundDarkColor}"
                        CornerRadius="0,0,5,5"
                        Padding="15,10">
                    <StackPanel Spacing="8">
                        <!-- Auto Start Checkbox -->
                        <CheckBox IsChecked="{Binding AutoStartMovement}"
                                  Content="Auto-start when application launches"
                                  ToolTip.Tip="When enabled, mouse movement will start automatically when the application starts"/>

                        <!-- Minimize to Tray Checkbox -->
                        <CheckBox IsChecked="{Binding MinimizeToTray}"
                                  Content="Minimize to tray"
                                  ToolTip.Tip="When enabled, the application will minimize to the system tray when minimized"/>

                        <!-- Start Minimized to Tray Checkbox (indented) -->
                        <CheckBox IsChecked="{Binding StartMinimizedToTray}"
                                  IsEnabled="{Binding MinimizeToTray}"
                                  Margin="24,0,0,0"
                                  Content="Start minimized to tray"
                                  ToolTip.Tip="When enabled, the application will start minimized to the system tray when launched"/>

                        <!-- Separator -->
                        <Separator Margin="0,4" />

                        <!-- Global Hotkey -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Global Hotkey:" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <Border Background="{DynamicResource BackgroundMediumColor}"
                                    BorderBrush="{DynamicResource BorderLightColor}"
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    Padding="8,4"
                                    VerticalAlignment="Center"
                                    Margin="0,0,8,0">
                                <TextBlock Text="{Binding GlobalHotkeyDisplayString}"
                                           IsVisible="{Binding !IsCapturingHotkey}"
                                           VerticalAlignment="Center"
                                           FontWeight="SemiBold" />
                            </Border>
                            <TextBlock Text="Press keys..."
                                       IsVisible="{Binding IsCapturingHotkey}"
                                       VerticalAlignment="Center"
                                       FontStyle="Italic"
                                       Opacity="0.7"
                                       Margin="0,0,8,0" />
                            <Button Content="Change"
                                    Command="{Binding StartCapturingHotkeyCommand}"
                                    IsVisible="{Binding !IsCapturingHotkey}"
                                    Padding="8,4"
                                    Margin="0,0,4,0"
                                    ToolTip.Tip="Click to set a new global hotkey" />
                            <Button Content="Cancel"
                                    Command="{Binding CancelCapturingHotkeyCommand}"
                                    IsVisible="{Binding IsCapturingHotkey}"
                                    Padding="8,4"
                                    Margin="0,0,4,0" />
                            <Button Content="Reset"
                                    Command="{Binding ResetHotkeyCommand}"
                                    Padding="8,4"
                                    ToolTip.Tip="Reset hotkey to Ctrl+Shift+F9" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Expander>
        </Grid>
    </Border>
</Window>
